<Window x:Class="WindowsDesktopEnhance.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Desktop Enhance Setup"
        Width="560"
        Height="490"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" CornerRadius="16" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#141218"/>
        <SolidColorBrush x:Key="CardBrush" Color="#211F26"/>
        <SolidColorBrush x:Key="ControlBrush" Color="#2B2930"/>
        <SolidColorBrush x:Key="BorderBrushSubtle" Color="#49454F"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E6E0E9"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#CAC4D0"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#D0BCFF"/>
        <SolidColorBrush x:Key="OnAccentBrush" Color="#381E72"/>
        <SolidColorBrush x:Key="SecondaryContainer" Color="#4F378B"/>
        <SolidColorBrush x:Key="OnSecondaryContainer" Color="#EADDFF"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style x:Key="PillAccentBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="Padding" Value="22,9"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillTonalBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSubtle}"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource SecondaryContainer}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LangPillRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="p" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="p" Property="Background" Value="{DynamicResource SecondaryContainer}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="M3CheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="box" Width="18" Height="18" CornerRadius="4"
                                    Background="Transparent" BorderBrush="{DynamicResource TextSecondary}" BorderThickness="1.6"
                                    Margin="0,0,10,0">
                                <Path x:Name="chk" Data="M 3,9 L 7,13 L 14,4" Stroke="{DynamicResource OnAccentBrush}"
                                      StrokeThickness="2" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="chk" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10" CornerRadius="16" Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="2" Opacity="0.38" Direction="270"/>
        </Border.Effect>

        <Grid x:Name="RootClipGrid" SizeChanged="RootClipGrid_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with Language Switcher & Close Button -->
            <Grid Grid.Row="0" Margin="18,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="14" Height="14" CornerRadius="3" Background="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="Windows Desktop Enhance" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,8,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <RadioButton x:Name="LangZhCn" Content="简" Tag="zh-CN" GroupName="SetupLang" Style="{StaticResource LangPillRadio}" Checked="Lang_Checked"/>
                    <RadioButton x:Name="LangZhTw" Content="繁" Tag="zh-TW" GroupName="SetupLang" Style="{StaticResource LangPillRadio}" Checked="Lang_Checked"/>
                    <RadioButton x:Name="LangEn" Content="EN" Tag="en-US" GroupName="SetupLang" Style="{StaticResource LangPillRadio}" Checked="Lang_Checked"/>
                    <RadioButton x:Name="LangJa" Content="日" Tag="ja-JP" GroupName="SetupLang" Style="{StaticResource LangPillRadio}" Checked="Lang_Checked"/>
                    <RadioButton x:Name="LangKo" Content="한" Tag="ko-KR" GroupName="SetupLang" Style="{StaticResource LangPillRadio}" Checked="Lang_Checked"/>
                </StackPanel>

                <Button Grid.Column="2" Width="32" Height="28" Background="Transparent" BorderThickness="0"
                        Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnClose_Click">
                    <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Width="9" Height="9" StrokeThickness="1.2"
                          Stroke="{DynamicResource TextSecondary}"/>
                </Button>
            </Grid>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="24,8,24,10">
                <TextBlock x:Name="LblTitle" Text="Windows Desktop Enhance 安装向导" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock x:Name="LblSubtitle" Text="..." FontSize="12.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                <!-- Install Location Card -->
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}"
                        BorderThickness="0.8" CornerRadius="14" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="LblPathLabel" Text="安装位置" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtInstallDir" Grid.Column="0"
                                     Background="{DynamicResource ControlBrush}"
                                     Foreground="{DynamicResource TextPrimary}"
                                     BorderBrush="{DynamicResource BorderBrushSubtle}"
                                     BorderThickness="0.8"
                                     Padding="10,7"
                                     FontFamily="Microsoft YaHei UI, Segoe UI"
                                     FontSize="12.5"
                                     VerticalContentAlignment="Center"/>
                            <Button x:Name="BtnBrowse" Grid.Column="1" Content="浏览..." Style="{StaticResource PillTonalBtn}"
                                    Margin="8,0,0,0" Click="BtnBrowse_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Install Options Card -->
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}"
                        BorderThickness="0.8" CornerRadius="14" Padding="16,14">
                    <StackPanel>
                        <TextBlock x:Name="LblOptionsLabel" Text="安装选项" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <CheckBox x:Name="ChkDesktopShortcut" Content="在桌面创建快捷方式" IsChecked="True" Style="{StaticResource M3CheckBox}"/>
                        <CheckBox x:Name="ChkAutoStart" Content="开机自动启动（静默启动到系统托盘）" IsChecked="True" Style="{StaticResource M3CheckBox}"/>
                        <CheckBox x:Name="ChkLaunchAfter" Content="安装完成后立即启动应用" IsChecked="True" Style="{StaticResource M3CheckBox}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="24,12,24,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblStatus" Grid.Column="0" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource PillTonalBtn}" Margin="0,0,8,0" Click="BtnClose_Click"/>
                        <Button x:Name="BtnInstall" Content="立即安装" Style="{StaticResource PillAccentBtn}" Click="BtnInstall_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
