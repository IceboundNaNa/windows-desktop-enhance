<Window x:Class="DesktopRightAlign.ZoneSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#44000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Cursor="Cross"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">

    <Grid>
        <Canvas x:Name="OverlayCanvas"
                Background="Transparent"
                MouseLeftButtonDown="OverlayCanvas_MouseLeftButtonDown"
                MouseMove="OverlayCanvas_MouseMove"
                MouseLeftButtonUp="OverlayCanvas_MouseLeftButtonUp">

            <!-- Active Selection Rectangle -->
            <Border x:Name="SelectionRect"
                    Visibility="Collapsed"
                    Background="#380078D7"
                    BorderBrush="#FF00A2FF"
                    BorderThickness="2"
                    CornerRadius="2">
                <Border Background="#CC1F1F1F"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="6"
                        Padding="8,4"
                        CornerRadius="2">
                    <TextBlock x:Name="SelectionSizeText"
                               Foreground="White"
                               FontFamily="Microsoft YaHei UI, Segoe UI"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                </Border>
            </Border>
        </Canvas>

        <!-- Windows 10 Snip-style Top Instruction Pill -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,20,0,0"
                Background="#E61F1F1F"
                BorderBrush="#66FFFFFF"
                BorderThickness="1"
                CornerRadius="4"
                Padding="18,10"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7A8;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                           Foreground="#FF00A2FF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="OverlayHintText"
                           Text="Drag on the desktop to draw an exclusion zone"
                           Foreground="White"
                           FontFamily="Microsoft YaHei UI, Segoe UI"
                           FontSize="13"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
