<Window x:Class="DesktopRightAlign.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Desktop Enhance"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="940"
        Height="670"
        MinWidth="840"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="10"
                      CornerRadius="16"
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="WindowRootBorder"
            Margin="10"
            CornerRadius="16"
            Background="{DynamicResource WindowBgBrush}"
            BorderBrush="{DynamicResource BorderBrushSubtle}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="2" Opacity="0.38" Direction="270"/>
        </Border.Effect>
        <Grid x:Name="WindowContentGrid" SizeChanged="WindowContentGrid_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <!-- Minimal Windows 10 Custom Title Bar -->
            <Grid Grid.Row="0" Background="{DynamicResource NavBgBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="pack://application:,,,/Assets/app_icon.png" Width="18" Height="18"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,9,0"/>
                    <TextBlock x:Name="TitleBarAppName" Text="Windows Desktop Enhance" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMinimize" Style="{StaticResource TitleBarButtonStyle}" Click="BtnMinimize_Click">
                        <Path Data="M 0,5 H 10" Width="10" Height="10" StrokeThickness="1"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              SnapsToDevicePixels="True"/>
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource TitleBarCloseButtonStyle}" Click="BtnClose_Click">
                        <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Width="9" Height="9" StrokeThickness="1.1"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Content Area: NavigationView + Page Host -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="192"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Navigation Rail -->
                <Border Grid.Column="0" Background="{DynamicResource NavBgBrush}"
                        BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="0,0,1,0">
                    <DockPanel Margin="0,10,0,10">
                        <StackPanel DockPanel.Dock="Top">
                            <RadioButton x:Name="NavOverview" Content="概览" Tag="&#xE80F;"
                                         Style="{StaticResource NavRadioButtonStyle}" IsChecked="True"
                                         Checked="NavItem_Checked"/>
                            <RadioButton x:Name="NavLayout" Content="布局与守护" Tag="&#xE74C;"
                                         Style="{StaticResource NavRadioButtonStyle}"
                                         Checked="NavItem_Checked"/>
                            <RadioButton x:Name="NavSystem" Content="设置" Tag="&#xE713;"
                                         Style="{StaticResource NavRadioButtonStyle}"
                                         Checked="NavItem_Checked"/>
                        </StackPanel>

                        <!-- Minimal Bottom Status Card -->
                        <Border DockPanel.Dock="Bottom" VerticalAlignment="Bottom"
                                Margin="12,0,12,4" Padding="14,12" CornerRadius="14"
                                Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="0.8">
                            <StackPanel>
                                <TextBlock x:Name="LblSidebarStatusTitle" Text="状态" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="SidebarStatusText" Text="手动模式" FontSize="12.5"
                                           FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="SidebarBackupText" Text="未保存布局" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- Right Page Container -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,18,22,18">
                    <Grid>
                        <!-- PAGE 1: OVERVIEW -->
                        <StackPanel x:Name="PageOverview" Visibility="Visible">
                            <TextBlock x:Name="LblOverviewTitle" Text="概览" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="LblOverviewSub" Text="自动靠右排列桌面图标，完整保留 Windows 原生排序方式。"
                                       FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                            <!-- Master Control & Quick Actions Card -->
                            <Border Style="{StaticResource FluentCardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblAutoArrangeTitle" Text="自动靠右排列" FontSize="14.5" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="LblAutoArrangeSub" Text="开启后接管系统自动排列，桌面变化时自动靠右重排"
                                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkAutoArrange" Grid.Column="1"
                                                  Style="{StaticResource Win10ToggleSwitchStyle}"
                                                  Click="ChkAutoArrange_Click"/>
                                    </Grid>

                                    <UniformGrid Columns="4">
                                        <Button x:Name="BtnArrangeNow" Style="{StaticResource FluentAccentButtonStyle}"
                                                Margin="0,0,8,0" Click="BtnArrangeNow_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8CB;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource OnAccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="LblBtnArrangeNow" Text="立即排列" Foreground="{DynamicResource OnAccentBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="BtnSaveLayout" Style="{StaticResource FluentButtonStyle}"
                                                Margin="0,0,8,0" Click="BtnSaveLayout_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="LblBtnSaveLayout" Text="保存布局" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="BtnRestoreLayout" Style="{StaticResource FluentButtonStyle}"
                                                Margin="0,0,8,0" Click="BtnRestoreLayout_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="LblBtnRestoreLayout" Text="还原布局" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="BtnDrawZoneOverview" Style="{StaticResource FluentButtonStyle}"
                                                Click="BtnDrawExclusionZone_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7A8;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="LblBtnDrawZone" Text="框选避让" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Native Sort Mode Card -->
                            <Border Style="{StaticResource FluentCardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblSortTitle" Text="排序方式" FontSize="14.5" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="LblSortSub" Text="与 Windows 桌面原生排序一致"
                                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton x:Name="RadSortAsc" Content="升序" GroupName="SortDir"
                                                         Style="{StaticResource SegmentRadioStyle}" Margin="0,0,4,0"
                                                         Checked="SortSetting_Changed"/>
                                            <RadioButton x:Name="RadSortDesc" Content="降序" GroupName="SortDir"
                                                         Style="{StaticResource SegmentRadioStyle}"
                                                         Checked="SortSetting_Changed"/>
                                        </StackPanel>
                                    </Grid>

                                    <UniformGrid Columns="4">
                                        <RadioButton x:Name="RadSortName" Content="名称" Tag="&#xE8D2;" GroupName="SortMode"
                                                     Style="{StaticResource SortTileRadioStyle}" Checked="SortSetting_Changed"/>
                                        <RadioButton x:Name="RadSortSize" Content="大小" Tag="&#xE74C;" GroupName="SortMode"
                                                     Style="{StaticResource SortTileRadioStyle}" Checked="SortSetting_Changed"/>
                                        <RadioButton x:Name="RadSortType" Content="项目类型" Tag="&#xE8B7;" GroupName="SortMode"
                                                     Style="{StaticResource SortTileRadioStyle}" Checked="SortSetting_Changed"/>
                                        <RadioButton x:Name="RadSortDate" Content="修改日期" Tag="&#xE823;" GroupName="SortMode"
                                                     Style="{StaticResource SortTileRadioStyle}" Margin="0" Checked="SortSetting_Changed"/>
                                    </UniformGrid>

                                    <!-- Per-Category Left / Right Alignment -->
                                    <Border BorderBrush="{DynamicResource BorderBrushSubtle}"
                                            BorderThickness="0,0.8,0,0"
                                            Margin="0,14,0,0"
                                            Padding="0,12,0,0">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="LblAlignRuleTitle" Grid.Column="0" Text="按类型选择靠左 / 靠右"
                                                           FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button x:Name="BtnAllLeft" Content="全部靠左" Style="{StaticResource FluentButtonStyle}"
                                                            Padding="10,4" FontSize="11.5" Margin="0,0,6,0" Click="BtnAllLeft_Click"/>
                                                    <Button x:Name="BtnAllRight" Content="全部靠右" Style="{StaticResource FluentButtonStyle}"
                                                            Padding="10,4" FontSize="11.5" Click="BtnAllRight_Click"/>
                                                </StackPanel>
                                            </Grid>

                                            <UniformGrid Columns="3">
                                                <Border Background="{DynamicResource ControlBgBrush}" CornerRadius="10" Padding="10,8" Margin="0,0,8,0">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                            <RadioButton x:Name="RadSysLeft" Content="靠左" GroupName="AlignSys" Style="{StaticResource SegmentRadioStyle}" Padding="9,4" FontSize="11.5" Margin="0,0,4,0" Checked="AlignSide_Changed"/>
                                                            <RadioButton x:Name="RadSysRight" Content="靠右" GroupName="AlignSys" Style="{StaticResource SegmentRadioStyle}" Padding="9,4" FontSize="11.5" Checked="AlignSide_Changed"/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="LblTypeSys" Text="系统图标" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                </Border>

                                                <Border Background="{DynamicResource ControlBgBrush}" CornerRadius="10" Padding="10,8" Margin="0,0,8,0">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                            <RadioButton x:Name="RadDirLeft" Content="靠左" GroupName="AlignDir" Style="{StaticResource SegmentRadioStyle}" Padding="9,4" FontSize="11.5" Margin="0,0,4,0" Checked="AlignSide_Changed"/>
                                                            <RadioButton x:Name="RadDirRight" Content="靠右" GroupName="AlignDir" Style="{StaticResource SegmentRadioStyle}" Padding="9,4" FontSize="11.5" Checked="AlignSide_Changed"/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="LblTypeDir" Text="文件夹" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                </Border>

                                                <Border Background="{DynamicResource ControlBgBrush}" CornerRadius="10" Padding="10,8">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                            <RadioButton x:Name="RadFileLeft" Content="靠左" GroupName="AlignFile" Style="{StaticResource SegmentRadioStyle}" Padding="9,4" FontSize="11.5" Margin="0,0,4,0" Checked="AlignSide_Changed"/>
                                                            <RadioButton x:Name="RadFileRight" Content="靠右" GroupName="AlignFile" Style="{StaticResource SegmentRadioStyle}" Padding="9,4" FontSize="11.5" Checked="AlignSide_Changed"/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="LblTypeFile" Text="文件与快捷方式" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                </Border>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Live Desktop Preview Card -->
                            <Border Style="{StaticResource FluentCardStyle}" Margin="0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblPreviewTitle" Text="桌面预览" FontSize="14.5" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="PreviewMetaText" Text="..."
                                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton x:Name="RadPreviewTarget" Content="靠右预览" GroupName="PreviewMode"
                                                         Style="{StaticResource SegmentRadioStyle}" IsChecked="True" Margin="0,0,4,0"
                                                         Checked="PreviewMode_Changed"/>
                                            <RadioButton x:Name="RadPreviewCurrent" Content="当前实况" GroupName="PreviewMode"
                                                         Style="{StaticResource SegmentRadioStyle}" Margin="0,0,6,0"
                                                         Checked="PreviewMode_Changed"/>
                                            <Button x:Name="BtnRefreshPreview" Content="刷新" Style="{StaticResource FluentButtonStyle}"
                                                    Padding="10,5" FontSize="12" Click="BtnRefreshPreview_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="{DynamicResource PreviewCanvasBgBrush}"
                                            BorderBrush="{DynamicResource BorderBrushSubtle}"
                                            BorderThickness="0.8" CornerRadius="12" Height="215" ClipToBounds="True">
                                        <Canvas x:Name="DesktopPreviewCanvas" SizeChanged="DesktopPreviewCanvas_SizeChanged"/>
                                    </Border>

                                    <!-- Integrated Exclusion Zones Section inside Desktop Preview Card -->
                                    <Border BorderBrush="{DynamicResource BorderBrushSubtle}"
                                            BorderThickness="0,0.8,0,0"
                                            Margin="0,14,0,0"
                                            Padding="0,12,0,0">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="LblZoneTitle" Text="桌面避让区域" FontSize="13.5" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="LblZoneSub" Text="靠右排列时自动跳过框选的区域，不遮挡壁纸或组件"
                                                               FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource FluentButtonStyle}"
                                                            Padding="10,5" FontSize="12" Margin="0,0,6,0"
                                                            Click="BtnDrawExclusionZone_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE7A8;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                            <TextBlock x:Name="LblBtnDrawZoneFull" Text="框选避让" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button x:Name="BtnClearZones" Content="清空全部"
                                                            Style="{StaticResource FluentButtonStyle}"
                                                            Padding="10,5" FontSize="12" Margin="0,0,10,0"
                                                            Click="BtnClearZones_Click"/>
                                                    <CheckBox x:Name="ChkExclusionEnabled"
                                                              Style="{StaticResource Win10ToggleSwitchStyle}"
                                                              Click="LayoutSetting_Changed"/>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel x:Name="ExclusionZonesListPanel"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- PAGE 2: LAYOUT & GUARD -->
                        <StackPanel x:Name="PageLayout" Visibility="Collapsed">
                            <TextBlock x:Name="LblLayoutPageTitle" Text="布局与守护" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="LblLayoutPageSub" Text="保存桌面布局快照、框选避让区域以及微调靠右网格。"
                                       FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                            <!-- Layout Snapshot & Guard Card -->
                            <Border Style="{StaticResource FluentCardStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="LblSnapshotTitle" Text="布局快照与防重置" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="SavedLayoutDetailText" Text="..."
                                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                    <WrapPanel Margin="0,0,0,14">
                                        <Button x:Name="BtnSaveCurrent" Content="保存当前布局" Style="{StaticResource FluentAccentButtonStyle}"
                                                Margin="0,0,8,0" Click="BtnSaveLayout_Click"/>
                                        <Button x:Name="BtnRestoreSaved" Content="还原已保存布局" Style="{StaticResource FluentButtonStyle}"
                                                Click="BtnRestoreLayout_Click"/>
                                    </WrapPanel>

                                    <Grid Margin="0,2,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock x:Name="LblGuardTitle" Text="系统切回时自动还原" FontSize="13.5" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="LblGuardSub" Text="分辨率切换、解锁屏幕、资源管理器重启或系统重置图标时自动恢复"
                                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkLayoutGuard" Grid.Column="1"
                                                  Style="{StaticResource Win10ToggleSwitchStyle}"
                                                  Click="LayoutSetting_Changed"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock x:Name="LblStartupRestoreTitle" Text="开机后自动还原布局" FontSize="13.5" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="LblStartupRestoreSub" Text="随系统启动等待桌面加载后恢复已保存的布局"
                                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkRestoreOnStartup" Grid.Column="1"
                                                  Style="{StaticResource Win10ToggleSwitchStyle}"
                                                  Click="LayoutSetting_Changed"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Grid & Margin Settings Card -->
                            <Border Style="{StaticResource FluentCardStyle}" Margin="0">
                                <StackPanel>
                                    <TextBlock x:Name="LblGridTitle" Text="网格与边距" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblFlowTitle" Text="列内排列方向" FontSize="13.5"/>
                                            <TextBlock x:Name="LblFlowSub" Text="满一列后自动向左换列" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton x:Name="RadFlowTop" Content="从上到下" GroupName="FlowDir"
                                                         Style="{StaticResource SegmentRadioStyle}" Margin="0,0,4,0"
                                                         Checked="LayoutSetting_Changed"/>
                                            <RadioButton x:Name="RadFlowBottom" Content="从下到上" GroupName="FlowDir"
                                                         Style="{StaticResource SegmentRadioStyle}"
                                                         Checked="LayoutSetting_Changed"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="56"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock x:Name="LblMarginRightTitle" Grid.Row="0" Grid.Column="0" Text="右边距" VerticalAlignment="Center"/>
                                        <Slider x:Name="SldRightMargin" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="120" TickFrequency="4" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                                        <TextBlock x:Name="LblRightMargin" Grid.Row="0" Grid.Column="2" Text="12 px" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>

                                        <TextBlock x:Name="LblMarginLeftTitle" Grid.Row="1" Grid.Column="0" Text="左边距" VerticalAlignment="Center"/>
                                        <Slider x:Name="SldLeftMargin" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="120" TickFrequency="4" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                                        <TextBlock x:Name="LblLeftMargin" Grid.Row="1" Grid.Column="2" Text="12 px" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>

                                        <TextBlock x:Name="LblMarginTopTitle" Grid.Row="2" Grid.Column="0" Text="上边距" VerticalAlignment="Center"/>
                                        <Slider x:Name="SldTopMargin" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="120" TickFrequency="4" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                                        <TextBlock x:Name="LblTopMargin" Grid.Row="2" Grid.Column="2" Text="12 px" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>

                                        <TextBlock x:Name="LblMarginBottomTitle" Grid.Row="3" Grid.Column="0" Text="下边距" VerticalAlignment="Center"/>
                                        <Slider x:Name="SldBottomMargin" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="120" TickFrequency="4" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                                        <TextBlock x:Name="LblBottomMargin" Grid.Row="3" Grid.Column="2" Text="12 px" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Grid>

                                    <Grid Margin="0,4,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock x:Name="LblNativeSpacingTitle" Text="跟随系统网格间距" FontSize="13.5"/>
                                            <TextBlock x:Name="LblNativeSpacingSub" Text="自动适配当前桌面图标大小与缩放比例" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkNativeSpacing" Grid.Column="1"
                                                  Style="{StaticResource Win10ToggleSwitchStyle}"
                                                  Click="LayoutSetting_Changed"/>
                                    </Grid>

                                    <Grid x:Name="CustomSpacingPanel" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="56"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock x:Name="LblCustomSpaceXTitle" Grid.Row="0" Grid.Column="0" Text="水平间距" VerticalAlignment="Center"/>
                                        <Slider x:Name="SldSpaceX" Grid.Row="0" Grid.Column="1" Minimum="56" Maximum="180" TickFrequency="4" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                                        <TextBlock x:Name="LblSpaceX" Grid.Row="0" Grid.Column="2" Text="96 px" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>

                                        <TextBlock x:Name="LblCustomSpaceYTitle" Grid.Row="1" Grid.Column="0" Text="垂直间距" VerticalAlignment="Center"/>
                                        <Slider x:Name="SldSpaceY" Grid.Row="1" Grid.Column="1" Minimum="56" Maximum="180" TickFrequency="4" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                                        <TextBlock x:Name="LblSpaceY" Grid.Row="1" Grid.Column="2" Text="96 px" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Grid>

                                    <Grid Margin="0,4,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock x:Name="LblAutoDisableTitle" Text="自动关闭系统原生自动排列" FontSize="13.5"/>
                                            <TextBlock x:Name="LblAutoDisableSub" Text="防止 Windows 将图标强制拉回左侧" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkAutoDisableNative" Grid.Column="1"
                                                  Style="{StaticResource Win10ToggleSwitchStyle}"
                                                  Click="LayoutSetting_Changed"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LblDebounceTitle" Grid.Column="0" Text="防抖延迟" VerticalAlignment="Center"/>
                                        <Slider x:Name="SldDebounce" Grid.Column="1" Minimum="150" Maximum="1500" TickFrequency="50" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                                        <TextBlock x:Name="LblDebounce" Grid.Column="2" Text="450 ms" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- PAGE 3: SETTINGS -->
                        <StackPanel x:Name="PageSystem" Visibility="Collapsed">
                            <TextBlock x:Name="LblSystemPageTitle" Text="设置" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="LblSystemPageSub" Text="管理开机启动、语言、主题外观与托盘行为。"
                                       FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                            <!-- Appearance & Language Card -->
                            <Border Style="{StaticResource FluentCardStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="LblAppearanceTitle" Text="外观与语言" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LblThemeLabel" Grid.Column="0" Text="主题模式" FontSize="13.5" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <RadioButton x:Name="RadThemeSystem" Content="跟随系统" GroupName="ThemeMode"
                                                         Style="{StaticResource SegmentRadioStyle}" Margin="0,0,4,0"
                                                         Checked="ThemeRadio_Checked"/>
                                            <RadioButton x:Name="RadThemeDark" Content="深色" GroupName="ThemeMode"
                                                         Style="{StaticResource SegmentRadioStyle}" Margin="0,0,4,0"
                                                         Checked="ThemeRadio_Checked"/>
                                            <RadioButton x:Name="RadThemeLight" Content="浅色" GroupName="ThemeMode"
                                                         Style="{StaticResource SegmentRadioStyle}"
                                                         Checked="ThemeRadio_Checked"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Material 3 Seed Color Swatches -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LblSeedColorLabel" Grid.Column="0" Text="主题色" FontSize="13.5" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton x:Name="SwatchViolet" Background="#6750A4" Tag="#6750A4" GroupName="SeedColor" Style="{StaticResource ColorSwatchRadioStyle}" Checked="SeedColor_Checked"/>
                                            <RadioButton x:Name="SwatchBlue" Background="#0061A4" Tag="#0061A4" GroupName="SeedColor" Style="{StaticResource ColorSwatchRadioStyle}" Checked="SeedColor_Checked"/>
                                            <RadioButton x:Name="SwatchTeal" Background="#006A6A" Tag="#006A6A" GroupName="SeedColor" Style="{StaticResource ColorSwatchRadioStyle}" Checked="SeedColor_Checked"/>
                                            <RadioButton x:Name="SwatchGreen" Background="#386A20" Tag="#386A20" GroupName="SeedColor" Style="{StaticResource ColorSwatchRadioStyle}" Checked="SeedColor_Checked"/>
                                            <RadioButton x:Name="SwatchAmber" Background="#8B5000" Tag="#8B5000" GroupName="SeedColor" Style="{StaticResource ColorSwatchRadioStyle}" Checked="SeedColor_Checked"/>
                                            <RadioButton x:Name="SwatchRose" Background="#984061" Tag="#984061" GroupName="SeedColor" Style="{StaticResource ColorSwatchRadioStyle}" Margin="0" Checked="SeedColor_Checked"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LblPureBlackLabel" Grid.Column="0" Text="纯黑深色背景" FontSize="13.5" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="ChkPureBlack" Grid.Column="1"
                                                  Style="{StaticResource Win10ToggleSwitchStyle}"
                                                  Click="PureBlack_Click"/>
                                    </Grid>

                                    <StackPanel>
                                        <TextBlock x:Name="LblLangLabel" Text="界面语言" FontSize="13.5" Margin="0,0,0,8"/>
                                        <WrapPanel>
                                            <RadioButton x:Name="RadLangAuto" Content="跟随系统" Tag="auto" GroupName="AppLang"
                                                         Style="{StaticResource SegmentRadioStyle}" Margin="0,0,6,6"
                                                         Checked="LanguageRadio_Checked"/>
                                            <RadioButton x:Name="RadLangZhCn" Content="简体中文" Tag="zh-CN" GroupName="AppLang"
                                                         Style="{StaticResource SegmentRadioStyle}" Margin="0,0,6,6"
                                                         Checked="LanguageRadio_Checked"/>
                                            <RadioButton x:Name="RadLangZhTw" Content="繁體中文" Tag="zh-TW" GroupName="AppLang"
                                                         Style="{StaticResource SegmentRadioStyle}" Margin="0,0,6,6"
                                                         Checked="LanguageRadio_Checked"/>
                                            <RadioButton x:Name="RadLangEn" Content="English" Tag="en-US" GroupName="AppLang"
                                                         Style="{StaticResource SegmentRadioStyle}" Margin="0,0,6,6"
                                                         Checked="LanguageRadio_Checked"/>
                                            <RadioButton x:Name="RadLangJa" Content="日本語" Tag="ja-JP" GroupName="AppLang"
                                                         Style="{StaticResource SegmentRadioStyle}" Margin="0,0,6,6"
                                                         Checked="LanguageRadio_Checked"/>
                                            <RadioButton x:Name="RadLangKo" Content="한국어" Tag="ko-KR" GroupName="AppLang"
                                                         Style="{StaticResource SegmentRadioStyle}" Margin="0,0,0,6"
                                                         Checked="LanguageRadio_Checked"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Startup & Tray Card -->
                            <Border Style="{StaticResource FluentCardStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="LblStartupCardTitle" Text="启动与托盘" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock x:Name="LblStartWithWinTitle" Text="开机自动启动" FontSize="13.5"/>
                                            <TextBlock x:Name="LblStartWithWinSub" Text="随 Windows 登录静默启动到系统托盘" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkStartWithWindows" Grid.Column="1"
                                                  Style="{StaticResource Win10ToggleSwitchStyle}"
                                                  Click="SystemSetting_Changed"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock x:Name="LblStartMinTitle" Text="启动时最小化到托盘" FontSize="13.5"/>
                                            <TextBlock x:Name="LblStartMinSub" Text="启动后在后台运行，不弹出主窗口" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkStartMinimized" Grid.Column="1"
                                                  Style="{StaticResource Win10ToggleSwitchStyle}"
                                                  Click="SystemSetting_Changed"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock x:Name="LblCloseToTrayTitle" Text="关闭时隐藏到托盘" FontSize="13.5"/>
                                            <TextBlock x:Name="LblCloseToTraySub" Text="保持后台守护运行，可在托盘菜单退出" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkMinimizeOnClose" Grid.Column="1"
                                                  Style="{StaticResource Win10ToggleSwitchStyle}"
                                                  Click="SystemSetting_Changed"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Diagnostics Card -->
                            <Border Style="{StaticResource FluentCardStyle}" Margin="0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LblDiagTitle" Grid.Column="0" Text="底层 Shell 诊断" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button x:Name="BtnRefreshDiag" Grid.Column="1" Content="刷新" Style="{StaticResource FluentButtonStyle}"
                                                Padding="12,5" FontSize="12" Click="BtnRefreshPreview_Click"/>
                                    </Grid>
                                    <TextBox x:Name="DiagnosticsTextBox"
                                             IsReadOnly="True"
                                             Background="{DynamicResource PreviewCanvasBgBrush}"
                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                             BorderBrush="{DynamicResource BorderBrushSubtle}"
                                             FontFamily="Consolas"
                                             FontSize="11.5"
                                             Padding="10,8"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             Height="126"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Minimal Bottom Status Bar -->
            <Border Grid.Row="2" Background="{DynamicResource NavBgBrush}"
                    BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="0,1,0,0"
                    Padding="14,0">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTimestampText" DockPanel.Dock="Right" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="StatusBarText" Text="就绪" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
